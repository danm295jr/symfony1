{% extends 'base.html.twig' %}

{% block title %}Каталог фильмов{% endblock %}

{% block body %}
    <h1>Каталог фильмов</h1>

    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>Название</th>
                <th>Год</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for movie in movies %}
                <tr>
                    <td>{{ movie.title }}</td>
                    <td>{{ movie.year }}</td>
                    <td>
                        <a href="{{ path('app_movie_show', {id: movie.id}) }}">Подробнее</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Фильмов пока нет</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
